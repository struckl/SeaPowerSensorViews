<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the places the mod binds to by NAME at run time (Harmony targets, reflection lookups): the compiler and
       compat-check cannot see those. Reads Seapower-Scripts.dll of a game's Managed folder with Cecil. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
